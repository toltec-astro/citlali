{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toltec.astro.umass.edu/schemas/sci-cal-001/owner-supplied-manifest-v2.json",
  "title": "SCI-CAL-001 owner-supplied input manifest",
  "description": "A compact manifest for partial or complete owner responses to SCI-CAL-001-ATM-INPUT-001 under the fixed versioned-AM12 evaluation path. It records evaluation-only governance, unresolved historical custody, study-definition responses, and digest-bound supplied artifacts without authorizing adoption, an operator, or an operational domain.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "request_id",
    "submission_date",
    "owner_path",
    "evaluation_authorization",
    "adoption_status",
    "operator_authorization",
    "operational_domain_authorization",
    "q95_operational_disposition",
    "successor_study_status",
    "study_artifact_binding_status",
    "historical_generic_generator_association",
    "historical_generic_lineage_custody_status",
    "responses",
    "artifacts",
    "successor_selection"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fact_id": {
      "enum": [
        "Q95-001",
        "GEN-001",
        "GEN-002",
        "PROF-001",
        "PROF-002",
        "SITE-001",
        "GRID-001",
        "MID-001",
        "SPEC-001",
        "BAND-001-CONDITIONAL",
        "DOMAIN-001"
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id",
        "disposition",
        "statement",
        "artifact_ids"
      ],
      "properties": {
        "fact_id": {
          "$ref": "#/$defs/fact_id"
        },
        "disposition": {
          "enum": [
            "evidence_supplied",
            "partial_evidence_supplied",
            "owner_choice_approved",
            "not_applicable_for_selected_path",
            "unresolved_retained"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "path",
        "bytes",
        "sha256",
        "custody_source",
        "original_bytes_preserved"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "md5_registry_identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "custody_source": {
          "type": "string",
          "minLength": 1
        },
        "original_bytes_preserved": {
          "type": "boolean"
        }
      }
    },
    "successor_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "model_version",
        "basis",
        "profile_family_rule",
        "frequency_grid_policy",
        "spectral_convention",
        "unresolved_line_status_policy",
        "historical_generic_products_replaced"
      ],
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "const": "copied_am_12_2"
        },
        "profile_family_rule": {
          "type": "string",
          "minLength": 1
        },
        "frequency_grid_policy": {
          "type": "string",
          "minLength": 1
        },
        "spectral_convention": {
          "enum": [
            "legacy_monochromatic",
            "band_integrated_new_convention"
          ]
        },
        "unresolved_line_status_policy": {
          "type": "string",
          "minLength": 1
        },
        "historical_generic_products_replaced": {
          "const": false
        }
      }
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "sci-cal-001-owner-supplied-manifest-v2"
    },
    "package_id": {
      "const": "SCI-CAL-001"
    },
    "request_id": {
      "const": "SCI-CAL-001-ATM-INPUT-001"
    },
    "submission_date": {
      "type": "string",
      "format": "date"
    },
    "submitted_by": {
      "type": "string",
      "minLength": 1
    },
    "owner_path": {
      "const": "versioned_am12_successor"
    },
    "evaluation_authorization": {
      "const": "bounded_study_only"
    },
    "adoption_status": {
      "const": "evaluation_only_not_adopted"
    },
    "operator_authorization": {
      "const": "none"
    },
    "operational_domain_authorization": {
      "const": "none"
    },
    "q95_operational_disposition": {
      "const": "excluded_historical_diagnostic_only"
    },
    "successor_study_status": {
      "const": "pending_results"
    },
    "study_artifact_binding_status": {
      "const": "unbound_pending_study_results"
    },
    "historical_generic_generator_association": {
      "const": "not_established"
    },
    "historical_generic_lineage_custody_status": {
      "const": "unresolved_retained"
    },
    "responses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/response"
      },
      "minItems": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "successor_selection": {
      "$ref": "#/$defs/successor_selection"
    }
  }
}
