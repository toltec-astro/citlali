{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toltec.example/sci-align-001/3c273/obsnum-allowlist-v1.schema.json",
  "title": "SCI-ALIGN-001 authoritative 3C273 observation allowlist",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "selection_authority", "obsnums"],
  "properties": {
    "schema_version": {"const": "sci-align-001-3c273-obsnum-allowlist-v1"},
    "corpus_id": {"type": "string", "minLength": 1},
    "selection_authority": {"type": "string", "minLength": 1},
    "obsnums": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    }
  }
}
