{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toltec.astro.umass.edu/schemas/citlali-frozen-lane-handoff-packet-v1.json",
  "title": "Citlali frozen-lane handoff packet",
  "description": "Exact-SHA lane or combined-candidate conformance packet. Schema validity is not acceptance or promotion authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_identity",
    "implementation_candidate",
    "packet_container",
    "freeze_snapshot",
    "authority",
    "repository_scope",
    "ancestry",
    "changed_scope",
    "independent_disposition",
    "scientific_change",
    "gate_policy",
    "gate_results",
    "generated_evidence",
    "local_evidence",
    "unity_evidence",
    "external_dependencies",
    "claims",
    "attestations",
    "approvals"
  ],
  "properties": {
    "schema_version": {
      "const": "citlali-frozen-lane-handoff-packet-v1"
    },
    "packet_identity": {
      "$ref": "#/$defs/packet_identity"
    },
    "implementation_candidate": {
      "$ref": "#/$defs/implementation_candidate"
    },
    "packet_container": {
      "$ref": "#/$defs/packet_container"
    },
    "freeze_snapshot": {
      "$ref": "#/$defs/freeze_snapshot"
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "repository_scope": {
      "$ref": "#/$defs/repository_scope"
    },
    "ancestry": {
      "$ref": "#/$defs/ancestry"
    },
    "changed_scope": {
      "$ref": "#/$defs/changed_scope"
    },
    "independent_disposition": {
      "$ref": "#/$defs/independent_disposition"
    },
    "scientific_change": {
      "$ref": "#/$defs/scientific_change"
    },
    "gate_policy": {
      "$ref": "#/$defs/gate_policy"
    },
    "gate_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gate_result"
      }
    },
    "generated_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/generated_evidence"
      }
    },
    "local_evidence": {
      "$ref": "#/$defs/local_evidence"
    },
    "unity_evidence": {
      "$ref": "#/$defs/unity_evidence"
    },
    "external_dependencies": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/external_dependency"
      }
    },
    "claims": {
      "$ref": "#/$defs/claims"
    },
    "attestations": {
      "$ref": "#/$defs/attestations"
    },
    "approvals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/approval"
      }
    }
  },
  "$defs": {
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "nullable_git_sha": {
      "oneOf": [
        {
          "$ref": "#/$defs/git_sha"
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullable_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "nullable_timestamp": {
      "oneOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "string_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonempty_string"
      }
    },
    "nonempty_string_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonempty_string"
      }
    },
    "repo_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "ref_name": {
      "type": "string",
      "pattern": "^refs/(heads|remotes|tags)/[A-Za-z0-9._/-]+$"
    },
    "blocking_stage": {
      "enum": [
        "lane_handoff",
        "intermediate_freeze",
        "combined_freeze",
        "combined_acceptance",
        "mainline_promotion",
        "refactor_apt_generation",
        "refactor_apt_activation",
        "production_end_to_end"
      ]
    },
    "packet_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "lane_id",
        "packet_kind",
        "recorded_at",
        "lifecycle_state",
        "target_stage"
      ],
      "properties": {
        "packet_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "lane_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "packet_kind": {
          "enum": [
            "cal_lane",
            "align_lane",
            "combined"
          ]
        },
        "recorded_at": {
          "$ref": "#/$defs/timestamp"
        },
        "lifecycle_state": {
          "enum": [
            "preparing",
            "frozen",
            "returned_for_repair",
            "blocked",
            "authority_decision_required"
          ]
        },
        "target_stage": {
          "enum": [
            "lane_handoff",
            "combined_acceptance"
          ]
        }
      }
    },
    "implementation_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ref",
        "snapshot_started_at",
        "snapshot_finished_at",
        "start_tip_sha",
        "end_tip_sha",
        "commit_sha",
        "parent_shas",
        "tree_sha",
        "authorized_base_sha",
        "authorized_base_tree",
        "merge_base_sha",
        "ahead_count",
        "behind_count",
        "standard_binary_patch_sha256",
        "name_status_sha256",
        "embedded_version",
        "implementation_frozen",
        "worktree_clean"
      ],
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/ref_name"
        },
        "snapshot_started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "snapshot_finished_at": {
          "$ref": "#/$defs/timestamp"
        },
        "start_tip_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "end_tip_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "commit_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "parent_shas": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/git_sha"
          }
        },
        "tree_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "authorized_base_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "authorized_base_tree": {
          "$ref": "#/$defs/git_sha"
        },
        "merge_base_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "ahead_count": {
          "type": "integer",
          "minimum": 0
        },
        "behind_count": {
          "type": "integer",
          "minimum": 0
        },
        "standard_binary_patch_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "name_status_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "embedded_version": {
          "$ref": "#/$defs/nonempty_string"
        },
        "implementation_frozen": {
          "type": "boolean"
        },
        "worktree_clean": {
          "type": "boolean"
        }
      }
    },
    "packet_container": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "commit_sha",
        "tree_sha",
        "separate_from_implementation"
      ],
      "properties": {
        "kind": {
          "enum": [
            "uncommitted_packet",
            "documentation_only_commit"
          ]
        },
        "commit_sha": {
          "$ref": "#/$defs/nullable_git_sha"
        },
        "tree_sha": {
          "$ref": "#/$defs/nullable_git_sha"
        },
        "separate_from_implementation": {
          "const": true
        }
      }
    },
    "freeze_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "availability",
        "start_sha",
        "end_sha",
        "verify_local"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonempty_string"
        },
        "availability": {
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "start_sha": {
          "$ref": "#/$defs/nullable_git_sha"
        },
        "end_sha": {
          "$ref": "#/$defs/nullable_git_sha"
        },
        "verify_local": {
          "type": "boolean"
        }
      }
    },
    "freeze_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "refs",
        "tip_moved"
      ],
      "properties": {
        "refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/freeze_ref"
          }
        },
        "tip_moved": {
          "type": "boolean"
        }
      }
    },
    "authority_path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "blob_sha"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repo_path"
        },
        "blob_sha": {
          "$ref": "#/$defs/git_sha"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "convergence_base_decision",
        "owner_decision_refs",
        "authority_paths"
      ],
      "properties": {
        "convergence_base_decision": {
          "$ref": "#/$defs/nonempty_string"
        },
        "owner_decision_refs": {
          "$ref": "#/$defs/nonempty_string_array"
        },
        "authority_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/authority_path"
          }
        }
      }
    },
    "repository_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citlali",
        "tolproj",
        "tolteca",
        "compensation_elsewhere_allowed"
      ],
      "properties": {
        "citlali": {
          "const": "repairable_in_current_authorized_repository_scope"
        },
        "tolproj": {
          "const": "repairable_only_in_separately_reviewed_repository_lane"
        },
        "tolteca": {
          "const": "blocked_deferred_read_only"
        },
        "compensation_elsewhere_allowed": {
          "const": false
        }
      }
    },
    "history_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_sha",
        "parent_shas",
        "tree_sha",
        "purpose",
        "categories",
        "import_disposition"
      ],
      "properties": {
        "commit_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "parent_shas": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/git_sha"
          }
        },
        "tree_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "purpose": {
          "$ref": "#/$defs/nonempty_string"
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "application",
              "test",
              "validation",
              "documentation",
              "generated_input",
              "generated_evidence",
              "audit",
              "failed_repair",
              "coordination",
              "contaminating_dependency"
            ]
          }
        },
        "import_disposition": {
          "enum": [
            "include_application",
            "exclude_non_application",
            "reconstruct_required"
          ]
        }
      }
    },
    "excluded_history_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_sha",
        "tree_sha",
        "category",
        "reason"
      ],
      "properties": {
        "commit_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "tree_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "category": {
          "enum": [
            "audit",
            "failed_repair",
            "abandoned",
            "generated_evidence",
            "coordination",
            "contaminating_dependency"
          ]
        },
        "reason": {
          "$ref": "#/$defs/nonempty_string"
        }
      }
    },
    "source_dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependency_id",
        "repository",
        "commit_sha",
        "classification",
        "disposition",
        "owner",
        "reason"
      ],
      "properties": {
        "dependency_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "repository": {
          "$ref": "#/$defs/nonempty_string"
        },
        "commit_sha": {
          "$ref": "#/$defs/nullable_git_sha"
        },
        "classification": {
          "enum": [
            "base_present",
            "lane_local",
            "cross_lane",
            "separately_promoted",
            "external_blocked",
            "contaminating"
          ]
        },
        "disposition": {
          "enum": [
            "imported",
            "reconstructed",
            "independently_required",
            "excluded",
            "deferred"
          ]
        },
        "owner": {
          "$ref": "#/$defs/nonempty_string"
        },
        "reason": {
          "$ref": "#/$defs/nonempty_string"
        }
      }
    },
    "ancestry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application_history",
        "excluded_history",
        "source_dependencies"
      ],
      "properties": {
        "application_history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/history_entry"
          }
        },
        "excluded_history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/excluded_history_entry"
          }
        },
        "source_dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_dependency"
          }
        }
      }
    },
    "changed_path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "path",
        "blob_sha",
        "category",
        "owner"
      ],
      "properties": {
        "status": {
          "enum": [
            "A",
            "M",
            "D",
            "T"
          ]
        },
        "path": {
          "$ref": "#/$defs/repo_path"
        },
        "blob_sha": {
          "$ref": "#/$defs/nullable_git_sha"
        },
        "category": {
          "$ref": "#/$defs/nonempty_string"
        },
        "owner": {
          "$ref": "#/$defs/nonempty_string"
        }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interface",
        "path",
        "architectural_owner",
        "scientific_owners",
        "lifecycle_owner",
        "classification",
        "required_evidence",
        "future_stage_owner"
      ],
      "properties": {
        "interface": {
          "$ref": "#/$defs/nonempty_string"
        },
        "path": {
          "oneOf": [
            {
              "$ref": "#/$defs/repo_path"
            },
            {
              "type": "null"
            }
          ]
        },
        "architectural_owner": {
          "$ref": "#/$defs/nonempty_string"
        },
        "scientific_owners": {
          "$ref": "#/$defs/nonempty_string_array"
        },
        "lifecycle_owner": {
          "$ref": "#/$defs/nonempty_string"
        },
        "classification": {
          "enum": [
            "additive",
            "textual_conflict",
            "semantic_conflict",
            "coupled"
          ]
        },
        "required_evidence": {
          "$ref": "#/$defs/nonempty_string_array"
        },
        "future_stage_owner": {
          "$ref": "#/$defs/nonempty_string"
        }
      }
    },
    "changed_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paths",
        "interfaces",
        "affected_modes",
        "governed_change_kinds"
      ],
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/changed_path"
          }
        },
        "interfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/interface"
          }
        },
        "affected_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "point",
              "oof",
              "science",
              "beammap"
            ]
          }
        },
        "governed_change_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "structural",
              "provenance",
              "algorithm",
              "numerical",
              "default",
              "schema",
              "scientific_product"
            ]
          }
        }
      }
    },
    "disposition_axes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scientific_contract",
        "implementation",
        "validation_readiness",
        "historical_fixture",
        "production",
        "verdict"
      ],
      "properties": {
        "scientific_contract": {
          "$ref": "#/$defs/nonempty_string"
        },
        "implementation": {
          "$ref": "#/$defs/nonempty_string"
        },
        "validation_readiness": {
          "$ref": "#/$defs/nonempty_string"
        },
        "historical_fixture": {
          "$ref": "#/$defs/nonempty_string"
        },
        "production": {
          "$ref": "#/$defs/nonempty_string"
        },
        "verdict": {
          "$ref": "#/$defs/nonempty_string"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "status",
        "owner",
        "blocking_stage",
        "rationale",
        "evidence_ids",
        "changed_at_candidate"
      ],
      "properties": {
        "finding_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "status": {
          "enum": [
            "closed",
            "accepted",
            "conditioned",
            "open",
            "blocked"
          ]
        },
        "owner": {
          "$ref": "#/$defs/nonempty_string"
        },
        "blocking_stage": {
          "$ref": "#/$defs/blocking_stage"
        },
        "rationale": {
          "$ref": "#/$defs/nonempty_string"
        },
        "evidence_ids": {
          "$ref": "#/$defs/string_array"
        },
        "changed_at_candidate": {
          "type": "boolean"
        }
      }
    },
    "independent_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_commit_sha",
        "review_tree_sha",
        "report_path",
        "report_sha256",
        "axes",
        "findings"
      ],
      "properties": {
        "review_commit_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "review_tree_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "report_path": {
          "$ref": "#/$defs/repo_path"
        },
        "report_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "axes": {
          "$ref": "#/$defs/disposition_axes"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      }
    },
    "scientific_change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "owner_basis",
        "ledger_path",
        "ledger_blob_sha",
        "change_ids",
        "predecessor_epoch_id",
        "successor_epoch_id",
        "successor_epoch_status",
        "profile_ids"
      ],
      "properties": {
        "state": {
          "enum": [
            "none",
            "declared"
          ]
        },
        "owner_basis": {
          "$ref": "#/$defs/nonempty_string"
        },
        "ledger_path": {
          "$ref": "#/$defs/repo_path"
        },
        "ledger_blob_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "change_ids": {
          "$ref": "#/$defs/string_array"
        },
        "predecessor_epoch_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonempty_string"
            },
            {
              "type": "null"
            }
          ]
        },
        "successor_epoch_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonempty_string"
            },
            {
              "type": "null"
            }
          ]
        },
        "successor_epoch_status": {
          "enum": [
            "none",
            "preparing",
            "active"
          ]
        },
        "profile_ids": {
          "$ref": "#/$defs/string_array"
        }
      }
    },
    "omission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "reason"
      ],
      "properties": {
        "authority": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "gate_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_gate_ids",
        "required_modes",
        "unity_required",
        "unity_omission"
      ],
      "properties": {
        "required_gate_ids": {
          "$ref": "#/$defs/nonempty_string_array"
        },
        "required_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "point",
              "oof",
              "science",
              "beammap"
            ]
          }
        },
        "unity_required": {
          "type": "boolean"
        },
        "unity_omission": {
          "$ref": "#/$defs/omission"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "location_kind",
        "path_or_uri",
        "source_commit_sha",
        "originating_candidate_sha",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
