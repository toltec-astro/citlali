{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sci-map-001-compact-group.schema.json",
  "title": "SCI-MAP-001 bounded compact evidence group",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_sha",
    "campaign_revision",
    "raw_input_manifest_sha256",
    "producer_identity",
    "source_stream_sha256",
    "realized_raw_timestream_provenance_sha256",
    "realized_mapmaking_provenance_sha256",
    "mapmaking_bundle_identity_digest",
    "obsnum",
    "array",
    "map_shape",
    "rates",
    "scan_order",
    "active_networks",
    "population",
    "stream_digests",
    "artifacts",
    "trace_selection"
  ],
  "properties": {
    "schema_version": {"const": "sci-map-001-compact-evidence-group-v1"},
    "candidate_sha": {"const": "ed28dafb37f9113c0d3c95297148157129a90886"},
    "campaign_revision": {"const": "repair-sha-ed28dafb-ed1-2026-08-02"},
    "raw_input_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "producer_identity": {"type": "string", "minLength": 1, "maxLength": 512},
    "source_stream_sha256": {"$ref": "#/$defs/sha256"},
    "realized_raw_timestream_provenance_sha256": {"$ref": "#/$defs/sha256"},
    "realized_mapmaking_provenance_sha256": {"$ref": "#/$defs/sha256"},
    "mapmaking_bundle_identity_digest": {
      "type": "string",
      "pattern": "^canonical-hexfloat-sha256-v1:[0-9a-f]{64}$"
    },
    "obsnum": {"enum": [152389, 152390, 152392]},
    "array": {"enum": ["a1100", "a1400", "a2000"]},
    "map_shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows", "cols", "pixel_size_rad"],
      "properties": {
        "rows": {"type": "integer", "minimum": 1},
        "cols": {"type": "integer", "minimum": 1},
        "pixel_size_rad": {"$ref": "#/$defs/pixel_size"}
      }
    },
    "rates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["native_fsmp_hz", "effective_d_fsmp_hz", "sample_interval_s"],
      "properties": {
        "native_fsmp_hz": {"$ref": "#/$defs/native_rate"},
        "effective_d_fsmp_hz": {"$ref": "#/$defs/effective_rate"},
        "sample_interval_s": {"$ref": "#/$defs/interval"}
      }
    },
    "scan_order": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/scan"}
    },
    "active_networks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0, "maximum": 12}
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scan_count",
        "detector_count",
        "pixel_count",
        "primitive_term_count",
        "selected_scan_count",
        "active_network_count",
        "trace_sequence_count",
        "trace_term_count"
      ],
      "properties": {
        "scan_count": {"type": "integer", "minimum": 1},
        "detector_count": {"type": "integer", "minimum": 1},
        "pixel_count": {"type": "integer", "minimum": 1},
        "primitive_term_count": {"type": "integer", "minimum": 1},
        "selected_scan_count": {"type": "integer", "minimum": 1, "maximum": 3},
        "active_network_count": {"type": "integer", "minimum": 1, "maximum": 13},
        "trace_sequence_count": {"type": "integer", "minimum": 1},
        "trace_term_count": {"type": "integer", "minimum": 1}
      }
    },
    "stream_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete_primitive_order_sha256",
        "population_membership_sha256",
        "identity_order_sha256",
        "eligibility_sha256",
        "contribution_sha256",
        "realization_signs_sha256"
      ],
      "properties": {
        "complete_primitive_order_sha256": {"$ref": "#/$defs/sha256"},
        "population_membership_sha256": {"$ref": "#/$defs/sha256"},
        "identity_order_sha256": {"$ref": "#/$defs/sha256"},
        "eligibility_sha256": {"$ref": "#/$defs/sha256"},
        "contribution_sha256": {"$ref": "#/$defs/sha256"},
        "realization_signs_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sufficient_statistics", "deterministic_trace", "trace_selection"],
      "properties": {
        "sufficient_statistics": {"$ref": "#/$defs/artifact"},
        "deterministic_trace": {"$ref": "#/$defs/artifact"},
        "trace_selection": {"$ref": "#/$defs/artifact"}
      }
    },
    "trace_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "fixed_budget_terms",
        "measured_terms",
        "sequence_count",
        "absence_fact_count"
      ],
      "properties": {
        "policy_id": {"const": "first-lower-middle-last-every-network-sha256-min-valid-flagged-v1"},
        "fixed_budget_terms": {"type": "integer", "minimum": 1},
        "measured_terms": {"type": "integer", "minimum": 1},
        "sequence_count": {"type": "integer", "minimum": 1},
        "absence_fact_count": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rate_base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decimal", "hex", "authority"],
      "properties": {
        "decimal": {"type": "string", "minLength": 1, "maxLength": 32},
        "hex": {"type": "string", "pattern": "^-?0x[0-9a-f]+\\.[0-9a-f]+p[+-][0-9]+$"},
        "authority": {"type": "string"}
      }
    },
    "native_rate": {
      "allOf": [
        {"$ref": "#/$defs/rate_base"},
        {"properties": {"authority": {"const": "telescope.fsmp"}}}
      ]
    },
    "effective_rate": {
      "allOf": [
        {"$ref": "#/$defs/rate_base"},
        {"properties": {"authority": {"const": "telescope.d_fsmp"}}}
      ]
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decimal", "hex", "authority"],
      "properties": {
        "decimal": {"type": "string", "minLength": 1, "maxLength": 32},
        "hex": {"type": "string", "pattern": "^-?0x[0-9a-f]+\\.[0-9a-f]+p[+-][0-9]+$"},
        "authority": {"const": "binary64(1/telescope.d_fsmp)"}
      }
    },
    "pixel_size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decimal", "hex", "authority"],
      "properties": {
        "decimal": {"type": "string", "minLength": 1, "maxLength": 32},
        "hex": {"type": "string", "pattern": "^-?0x[0-9a-f]+\\.[0-9a-f]+p[+-][0-9]+$"},
        "authority": {"const": "realized_mapmaking.effective_pixel_size_rad"}
      }
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scan_index", "scan_identity", "sample_count"],
      "properties": {
        "scan_index": {"type": "integer", "minimum": 0},
        "scan_identity": {"type": "string", "minLength": 1, "maxLength": 256},
        "sample_count": {"type": "integer", "minimum": 1}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "stored_bytes"],
      "properties": {
        "path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "stored_bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
