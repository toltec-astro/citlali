{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sci-map-001-producer-stream.schema.json",
  "title": "SCI-MAP-001 full/all processed-TOD direct/fixture stream authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter",
    "capture_output_mode",
    "capture_detector_selection",
    "candidate_sha",
    "campaign_revision",
    "raw_input_manifest_sha256",
    "producer_identity",
    "capture_ptc_sha256",
    "realized_raw_timestream_provenance_sha256",
    "realized_mapmaking_provenance_sha256",
    "mapmaking_bundle_identity_digest",
    "obsnum",
    "array",
    "map_shape",
    "map_pixel_size_rad",
    "native_fsmp_hz",
    "effective_d_fsmp_hz",
    "scan_order",
    "detector_order",
    "primitive_term_count",
    "term_order"
  ],
  "properties": {
    "schema_version": {"const": "sci-map-001-producer-stream-v1"},
    "adapter": {"enum": ["full-ptc-normalized-npz-v1", "candidate-full-ptc-netcdf-v1"]},
    "capture_output_mode": {"const": "full"},
    "capture_detector_selection": {"const": "all"},
    "candidate_sha": {"const": "ed28dafb37f9113c0d3c95297148157129a90886"},
    "campaign_revision": {"const": "repair-sha-ed28dafb-ed1-2026-08-02"},
    "raw_input_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "producer_identity": {"type": "string", "minLength": 1, "maxLength": 512},
    "capture_ptc_sha256": {"$ref": "#/$defs/sha256"},
    "realized_raw_timestream_provenance_sha256": {"$ref": "#/$defs/sha256"},
    "realized_mapmaking_provenance_sha256": {"$ref": "#/$defs/sha256"},
    "mapmaking_bundle_identity_digest": {
      "type": "string",
      "pattern": "^canonical-hexfloat-sha256-v1:[0-9a-f]{64}$"
    },
    "obsnum": {"enum": [152389, 152390, 152392]},
    "array": {"enum": ["a1100", "a1400", "a2000"]},
    "map_shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows", "cols"],
      "properties": {
        "rows": {"type": "integer", "minimum": 1},
        "cols": {"type": "integer", "minimum": 1}
      }
    },
    "map_pixel_size_rad": {"$ref": "#/$defs/pixel_size"},
    "native_fsmp_hz": {"$ref": "#/$defs/rate"},
    "effective_d_fsmp_hz": {"$ref": "#/$defs/rate"},
    "scan_order": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/scan"}
    },
    "detector_order": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/detector"}
    },
    "primitive_term_count": {"type": "integer", "minimum": 1},
    "term_order": {"const": "scan-major-detector-major-sample-minor-cartesian-v1"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decimal", "hex", "authority"],
      "properties": {
        "decimal": {"type": "string", "minLength": 1, "maxLength": 32},
        "hex": {"type": "string", "pattern": "^-?0x[0-9a-f]+\\.[0-9a-f]+p[+-][0-9]+$"},
        "authority": {"enum": ["telescope.fsmp", "telescope.d_fsmp"]}
      }
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scan_index", "scan_identity", "output_scan_index", "sample_count"],
      "properties": {
        "scan_index": {"type": "integer", "minimum": 0},
        "scan_identity": {"type": "string", "minLength": 1, "maxLength": 256},
        "output_scan_index": {"type": "integer", "minimum": 1},
        "sample_count": {"type": "integer", "minimum": 1}
      }
    },
    "detector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detector_index", "apt_row_index", "detector_identity",
        "detector_uid", "network", "kids_tone", "apt_flagged"
      ],
      "properties": {
        "detector_index": {"type": "integer", "minimum": 0},
        "apt_row_index": {"type": "integer", "minimum": 0},
        "detector_identity": {"type": "string", "minLength": 1, "maxLength": 512},
        "detector_uid": {"type": "string", "minLength": 1, "maxLength": 256},
        "network": {"type": "integer", "minimum": 0, "maximum": 12},
        "kids_tone": {"type": "integer", "minimum": 0},
        "apt_flagged": {"type": "boolean"}
      }
    },
    "pixel_size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decimal", "hex", "authority"],
      "properties": {
        "decimal": {"type": "string", "minLength": 1, "maxLength": 32},
        "hex": {"type": "string", "pattern": "^-?0x[0-9a-f]+\\.[0-9a-f]+p[+-][0-9]+$"},
        "authority": {"const": "realized_mapmaking.effective_pixel_size_rad"}
      }
    }
  }
}
