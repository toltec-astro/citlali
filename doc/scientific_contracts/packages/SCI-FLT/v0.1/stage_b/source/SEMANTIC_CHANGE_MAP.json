  "equation_changes": [
    {
      "subject": "complete applied operator",
      "r0_1": "y = J_full L_Theta m",
      "r0_2": "A_Theta,J = J_full L_Theta; y = A_Theta,J m",
      "disposition": "clarified",
      "meaning": "strict linearity is conditional on one parent-state-dependent selector frozen before payload arithmetic"
    },
    {
      "subject": "selector",
      "r0_1": "J_full selects complete required footprints",
      "r0_2": "J_full = J(plan, immutable parent domain, FLT input admission, availability, finiteness, support, required predicates)",
      "disposition": "closed",
      "meaning": "selector inputs and freeze timing are explicit"
    },
    {
      "subject": "convolution support",
      "r0_1": "one K_Theta served arithmetic and footprint roles",
      "r0_2": "K_geom, K_nonzero, and K_req are distinct; base v0.1 uses K_req = K_geom",
      "disposition": "repaired",
      "meaning": "exact-zero coefficients and zero operator cannot obtain accidental admission semantics"
    },
    {
      "subject": "covariance propagation",
      "r0_1": "C_out = J_full L_Theta C_parent transpose(L_Theta) transpose(J_full)",
      "r0_2": "C_out = A_Theta,J C_parent transpose(A_Theta,J)",
      "disposition": "notation_closed",
      "meaning": "the same complete frozen applied operator is explicit on both sides"
    },
    {
      "subject": "independent-diagonal covariance",
      "r0_1": "k[i,j] notation was undefined",
      "r0_2": "A_ij = (J_full L_Theta)_ij; Var(y_i) = sum_j A_ij^2 V_j; Cov(y_i,y_l) = sum_j A_ij A_lj V_j",
      "disposition": "repaired",
      "meaning": "row selection, domain, and operator entries are explicit"
    },
    {
      "subject": "parent full-procedure response with FLT fixed",
      "r0_1": "not separately typed",
      "r0_2": "Delta y_parent-FP = A_Theta,J Delta m_parent-FP",
      "disposition": "added",
      "meaning": "parent state change remains separate and FLT does not re-resolve"
    }
