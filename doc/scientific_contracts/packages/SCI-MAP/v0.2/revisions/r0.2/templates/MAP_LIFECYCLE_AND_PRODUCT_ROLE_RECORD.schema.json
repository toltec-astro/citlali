{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SCI-MAP:v0.2-r0.2:lifecycle-product-role-record@1",
  "title": "SCI-MAP lifecycle and product-role record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_identity",
    "product_role",
    "base_parent_identity",
    "ordered_membership",
    "stages",
    "termination"
  ],
  "properties": {
    "record_identity": {"type": "string", "minLength": 1},
    "product_role": {
      "enum": [
        "SCI-MAP:base_observation_map@1",
        "SCI-MAP:response_bearing_observation_map@1",
        "SCI-MAP:covariance_qualified_observation_map@1",
        "SCI-MAP:base_coadd@1",
        "SCI-MAP:response_bearing_coadd@1",
        "SCI-MAP:covariance_qualified_coadd@1"
      ]
    },
    "base_parent_identity": {"type": ["string", "null"]},
    "ordered_membership": {"type": "array", "items": {"type": "string"}},
    "stages": {
      "description": "Contains only stages actually reached, as an ordered prefix; no future-stage placeholder.",
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "identity", "value_or_state", "parent_stage_identity", "cause", "provenance"],
        "properties": {
          "stage": {"enum": ["requested", "effective", "observation_resolved", "applied", "realized"]},
          "identity": {"type": "string", "minLength": 1},
          "value_or_state": {},
          "parent_stage_identity": {"type": ["string", "null"]},
          "cause": {"type": ["string", "null"]},
          "provenance": {"type": "object"}
        }
      }
    },
    "termination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "cause", "failure_scope", "realized_product_identity"],
      "properties": {
        "class": {"enum": ["completed_realization", "pre_application_stop", "post_application_pre_realization_failure"]},
        "cause": {"type": ["string", "null"]},
        "failure_scope": {"type": ["string", "null"]},
        "realized_product_identity": {"type": ["string", "null"]}
      }
    }
  }
}

