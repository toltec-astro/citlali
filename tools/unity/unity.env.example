# Copy to a shell snippet or export these before running tools/unity scripts.

export UNITY_HOST=unity_toltec
export UNITY_BASELINE_REPO=/home/toltec_umass_edu/work_toltec/citlali_dev/citlali
export UNITY_REPO=/home/toltec_umass_edu/work_toltec/citlali_dev/citlali_refactor
export BUILD_DIR=build
export PRESET=unity_release
export TARGET=citlali_cli
export JOBS=8

export CITLALI_REFACTOR_REPO=/home/toltec_umass_edu/work_toltec/citlali_dev/citlali_refactor
export CITLALI_REFACTOR_BRANCH=codex/structural-refactor
export CITLALI_REFACTOR_BUILD_DIR=/home/toltec_umass_edu/work_toltec/citlali_dev/citlali_refactor/build
export CITLALI_REFACTOR_PRESET=
export CITLALI_REFACTOR_BUILD_TYPE=Release
export CITLALI_REFACTOR_TARGET=citlali_cli
# Leave unset to auto-detect with nproc/getconf; set to cap build jobs.
# export CITLALI_REFACTOR_JOBS=8
# Default is auto: configure only when missing/stale or CMake inputs changed.
# Use always to force configure, or never to fail instead of configuring.
# export CITLALI_REFACTOR_CONFIGURE=auto
export CITLALI_CONAN_CMD=/work/toltec/toltec_shared/toltec_astro/extern/pyenv/versions/conan1/bin/conan
export CITLALI_USE_INSTALLED_NETCDF=ON
# Leave CITLALI_TULA_DIR unset to match the existing citlali/build workflow,
# where CMake fetches tula into build/_deps/tula-src.
# export CITLALI_TULA_DIR=/home/toltec_umass_edu/work_toltec/citlali_dev/tula
