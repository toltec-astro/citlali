@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@TULA_PERFLIBS_ENABLE_OPENMP@)
    # FindOpenMP cannot rediscover Homebrew LLVM's runtime when downstream
    # packages configure with an older CMake. Replay the exact facts used to
    # build this package, then restore the caller's discovery variables.
    foreach(
        _variable
        IN ITEMS
            OpenMP_CXX_FLAGS
            OpenMP_CXX_LIB_NAMES
            OpenMP_omp_LIBRARY
            OpenMP_CXX_INCLUDE_DIR
    )
        if(DEFINED ${_variable})
            set("_TulaPerflibs_${_variable}_was_defined" TRUE)
            set("_TulaPerflibs_${_variable}_value" "${${_variable}}")
        else()
            set("_TulaPerflibs_${_variable}_was_defined" FALSE)
        endif()
    endforeach()

    set(OpenMP_CXX_FLAGS "@OpenMP_CXX_FLAGS@")
    set(OpenMP_CXX_LIB_NAMES "@OpenMP_CXX_LIB_NAMES@")
    set(OpenMP_omp_LIBRARY "@OpenMP_omp_LIBRARY@")
    set(OpenMP_CXX_INCLUDE_DIR "@OpenMP_CXX_INCLUDE_DIR@")
    find_dependency(OpenMP COMPONENTS CXX)

    foreach(
        _variable
        IN ITEMS
            OpenMP_CXX_FLAGS
            OpenMP_CXX_LIB_NAMES
            OpenMP_omp_LIBRARY
            OpenMP_CXX_INCLUDE_DIR
    )
        if(_TulaPerflibs_${_variable}_was_defined)
            set(_saved_value "_TulaPerflibs_${_variable}_value")
            set(${_variable} "${${_saved_value}}")
        else()
            unset(${_variable})
        endif()
        unset("_TulaPerflibs_${_variable}_was_defined")
        unset("_TulaPerflibs_${_variable}_value")
    endforeach()
    unset(_saved_value)
    unset(_variable)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/TulaPerflibsTargets.cmake")
check_required_components(TulaPerflibs)
