@PACKAGE_INIT@

cmake_policy(PUSH)
if(POLICY CMP0144)
    cmake_policy(SET CMP0144 NEW)
endif()

include(CMakeFindDependencyMacro)

find_dependency(kidscpp 3.1 CONFIG)
find_dependency(
    tula 3.1 CONFIG
    COMPONENTS core logging yaml ecsv eigen netcdf enum cli perflibs grppi
)
find_dependency(TulaCcfits 1 CONFIG)
find_dependency(netCDF CONFIG)
find_dependency(Ceres 2.2 CONFIG)
find_dependency(Boost 1.83 CONFIG)
find_dependency(spectra 1.0 CONFIG)
find_dependency(HDF5 COMPONENTS C HL)
find_dependency(ZLIB)
find_dependency(PkgConfig)
pkg_check_modules(FFTW3 REQUIRED IMPORTED_TARGET fftw3)
set(_citlali_saved_module_path "${CMAKE_MODULE_PATH}")
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
find_dependency(FFTW3Threads)
set(CMAKE_MODULE_PATH "${_citlali_saved_module_path}")
unset(_citlali_saved_module_path)
cmake_policy(POP)

include("${CMAKE_CURRENT_LIST_DIR}/citlaliTargets.cmake")
check_required_components(citlali)
