kids:
  fitter:
    modelspec: gainlintrend
    weight_window:
      fwhm_Hz: 1.5e4
      type: lorentz
  solver:
    extra_output: no
    fitreportdir: ../data
    parallel_policy: seq
mapmaking:
  coverage_cut: 0.5
  crpix1: 0
  crpix2: 0
  crval1_J2000: 0
  crval2_J2000: 0
  cunit: mJy/beam
  enabled: yes
  grouping: auto
  jinc_filter:
    r_max: 1.5
    shape_params:
      a1100:
        - 1.1
        - 1.67
        - 2.0
      a1400:
        - 1.1
        - 2.17
        - 2.0
      a2000:
        - 1.1
        - 3.17
        - 2.0
  maximum_likelihood:
    max_iterations: 50
    tolerance: 1e-20
  method: jinc
  pixel_axes: radec
  pixel_size_arcsec: 2.0
  tan_dec: 0
  tan_ra: 0
  x_size_pix: 0
  y_size_pix: 0
noise_maps:
  enabled: yes
  n_noise_maps: 10
  randomize_dets: no
post_processing:
  map_filtering:
    enabled: yes
    normalize_errors: yes
    type: convolve
  map_histogram_n_bins: 20
  source_finding:
    enabled: no
    mode: default
    source_sigma: 0.0
    source_window_arcsec: 0
  source_fitting:
    bounding_box_arcsec: 10
    fitting_radius_arcsec: 30
    gauss_model:
      amp_limit_factors:
        - 0.0
        - 0.0
      fit_rotation_angle: no
      fwhm_limit_factors:
        - 0.0
        - 0.0
    model: gaussian
runtime:
  interp_over_gaps: yes
  meta:
    version: tolteca...
  n_threads: 16
  output_dir: /work/toltec/wilson/citlali_testing/serpens_small/new/reduced/
  parallel_policy: omp
  reduction_type: science
  use_subdir: yes
  verbose: no
timestream:
  chunking:
    chunk_mode: duration
    force_chunking: yes
    value: 30
  enabled: yes
  fruit_loops:
    array_flux_limit:
      - 7.0
      - 7.0
      - 4.0
    enabled: no
    max_iters: 100
    mode: upper
    path: ~
    save_all_iters: no
    sig2noise_limit: 2.5
    type: coadd/raw
  output:
    stats:
      eigenvalues: no
    subdir_name: ~
  polarimetry:
    enabled: no
    grouping: fg
    ignore_hwpr: auto
  precompute_pointing: no
  processed_time_chunk:
    clean:
      enabled: yes
      grouping:
        - nw
      mask_radius_arcsec: 0
      n_eig_to_cut:
        a1100:
          - 20
        a1400:
          - 20
        a2000:
          - 20
      stddev_limit: 0
      stdev_limit: 0.0
      tau: 0.0
    flagging:
      lower_tod_inv_var_factor: 0.01
      upper_tod_inv_var_factor: 10.0
    output:
      enabled: no
    weighting:
      lower_map_weight_factor: 0.01
      median_map_weight_factor: 5
      type: approximate
      upper_map_weight_factor: 10.0
  raw_time_chunk:
    despike:
      enabled: no
      min_spike_sigma: 8.0
      time_constant_sec: 0.015
      window_size: 32
